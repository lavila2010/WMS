{
  "name": "WMS (Flask + PostgreSQL)",
  "install": "./.cursor/install.sh",
  "start": "./.cursor/start.sh",
  "terminals": [
    {
      "name": "flask-web",
      "command": "export DATABASE_URL=\"${DATABASE_URL:-postgresql://wms:wms@127.0.0.1:5432/wms}\"; ./.venv/bin/flask --app wsgi run --host 0.0.0.0 --port 5000",
      "description": "WMS Flask dev server on http://localhost:5000"
    }
  ],
  "ports": [
    {
      "name": "web",
      "port": 5000
    }
  ]
}
