# Copy to .env and fill in.
#
# Production: Aiven PostgreSQL connection string (SSL is required and is
# added automatically for non-local hosts):
#   DATABASE_URL="postgres://<user>:<password>@<host>:<port>/<db>?sslmode=require"
#
# Local development (the Cloud Agent environment provisions this local DB):
DATABASE_URL="postgresql://wms:wms@127.0.0.1:5432/wms"

# Separate database used by the automated test suite:
TEST_DATABASE_URL="postgresql://wms:wms@127.0.0.1:5432/wms_test"

# Flask session signing key (Render generates one automatically):
SECRET_KEY="dev-insecure-secret-key"

# Set to "true" in production (HTTPS) to send session cookies only over TLS:
SESSION_COOKIE_SECURE="false"

# NOTE: never store admin credentials here. Create the first admin with:
#   flask --app wsgi create-admin
